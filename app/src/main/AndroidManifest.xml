<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 首版不声明 INTERNET：核心展示完全本地。R1 支付接入时再按渠道需要添加。 -->

    <!-- 应用可见性：仅用于显示来源应用名与“打开来源”入口；不使用 QUERY_ALL_PACKAGES。 -->
    <queries>
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.tencent.qqmusic" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MusicCanvasApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicCanvas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.MusicCanvas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".desk.DeskActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop"
            android:showWhenLocked="false"
            android:theme="@style/Theme.MusicCanvas.Desk" />

        <!-- 系统绑定保护：BIND_NOTIFICATION_LISTENER_SERVICE 只授予系统，不向用户弹窗申请。 -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="false"
            android:label="@string/listener_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
